<?xml version="1.0"?>

<!-- gps蘑菇头天线描述文件 -->

<robot name="gps_antenna" xmlns:xacro="http://www.ros.org/wiki/xacro" >
   
    <!-- gps蘑菇头支撑杆 -->
    <link name="gps_antenna_pole">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.2" radius="0.01"/>
        </geometry>
        <material name="">
          <color rgba="0.5 0.5 0.5 1"/>
        </material>
      </visual>
    </link>
    <joint name="gps_antenna_pole_joint" type="fixed">
      <origin xyz="0.38 0 0.1" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="gps_antenna_pole"/>
    </joint>

    <!-- 天线主体 -->
    <link name="gps_antenna">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://hunter_se_description/meshes/RTK/gps_antenna.stl"/>
        </geometry>
        <material name="">
          <color rgba="1.0 1.0 0.9 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://hunter_se_description/meshes/RTK/gps_antenna.stl"/>
        </geometry>
      </collision>
    </link>
    <joint name="gps_antenna_joint" type="fixed">
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <parent link="gps_antenna_pole"/>
      <child link="gps_antenna"/>
    </joint>


  <!-- 插件配置 -->
  <gazebo reference="gps_antenna">
    <material>Gazebo/Red</material> 
    <plugin name="gazebo_ros_gps" filename="libhector_gazebo_ros_gps.so">
      <alwaysOn>true</alwaysOn>
      <updateRate>5.0</updateRate>
      <bodyName>gps_antenna</bodyName>
      <frameId>gps_antenna</frameId>
      <topicName>hector_gps/fix</topicName>
      <velocityTopicName>hector_gps/fix_velocity</velocityTopicName>
      <referenceLatitude>-30.06022459407145675</referenceLatitude>
      <referenceLongitude>-51.173913575780311191</referenceLongitude>
      <referenceHeading>90</referenceHeading>
      <referenceAltitude>10</referenceAltitude>
      <offset>0 0 0</offset>
      <drift>0.001 0.001 0.001</drift>
      <gaussianNoise>0.05 0.05 0.05</gaussianNoise>
      <velocityDrift>0.001 0.001 0.001</velocityDrift>
      <velocityGaussianNoise>0.5 0.5 0.5</velocityGaussianNoise>
    </plugin>
  </gazebo>

</robot>