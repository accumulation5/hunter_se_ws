        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <population name='orchard'>
      <model name='oak_tree'>
        <frame name='oak_tree::__model__' attached_to='oak_tree::link'>
          <pose relative_to='__model__'>0 0 0 0 -0 0</pose>
        </frame>
        <static>1</static>
        <link name='oak_tree::link'>
          <collision name='collision'>
            <geometry>
