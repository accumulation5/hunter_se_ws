<?xml version="1.0"?>
<robot name="gps_antenna" xmlns:xacro="http://www.ros.org/wiki/xacro">  
  
  <!-- gps/rtk 插件配置 -->
  <gazebo reference="gps_antenna">
    <sensor name="gps_plugin" type="gps">
    <!-- ensure the sensor is active (required) -->
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <plugin name="gps_plugin" filename="libgazebo_ros_gps_sensor.so">
          <ros>
            <!-- publish to /gps/data -->
            <namespace>/</namespace>
            <remapping>~/out:=/gps/fix</remapping>
          </ros>
          <frame_name>gps_antenna</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>