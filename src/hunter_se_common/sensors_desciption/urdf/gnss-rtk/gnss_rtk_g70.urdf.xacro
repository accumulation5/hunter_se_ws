<?xml version="1.0" encoding="utf-8"?>

<!-- hector团队编写的gps定位模型描述文件与仿真插件；mesh使用轮趣G70_RTK模块 -->

<robot name="gnss_rtk_g70" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="gnss_rtk_g70">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find sensors_desciption)/meshes/RTK/RTK_G70.stl"
          scale="0.001 0.001 0.001" />
        <!-- <mesh filename="package://sensors_desciption/meshes/RTK/RTK_G70.stl" 
            scale="0.001 0.001 0.001" /> -->
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find sensors_desciption)/meshes/RTK/RTK_G70.stl"
          scale="0.001 0.001 0.001" />
        <!-- <mesh filename="package://sensors_desciption/meshes/RTK/RTK_G70.stl" 
          scale="0.001 0.001 0.001"/> -->
      </geometry>
      <material name="orange">
        <color rgba="1 0.5 0.1 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1"/>
      <inertia
        ixx="1.0" ixy="0.0" ixz="0.0"
        iyy="1.0" iyz="0.0"
        izz="1.0"/>
    </inertial>
  </link>

  <joint name="gnss_rtk_g70_to_base_link" type="fixed">
    <parent link="base_link"/>
    <child link="gnss_rtk_g70"/>
    <origin xyz="0 0 0" />
  </joint>

  
</robot>