<?xml version="1.0"?>
<robot name="imu" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find sensors_desciption)/urdf/imu/imu.gazebo.xacro"/>

	<joint name="imu_joint" type="fixed">
	  <parent link="base_link"/>
	  <child link="imu_link"/>
		<origin xyz="0.10 0 0.40" />
		<!-- <origin xyz="0.0 0.0 0.0" /> -->
	</joint>

	<link name="imu_link">
	  <visual>
			<geometry>
				<mesh filename="file://$(find sensors_desciption)/meshes/imu/H30WP.stl"
					scale="0.001 0.001 0.001"/>
			</geometry>
	  </visual>
		<collision>
			<geometry>
				<mesh filename="file://$(find sensors_desciption)/meshes/imu/H30WP.stl"
					scale="0.001 0.001 0.001"/>
			</geometry>
		</collision>
	  <inertial>
			<origin xyz="0 0 0"/>
			<mass value="0.005"/>
			<inertia ixx="1.67e-8" ixy="0" ixz="0" iyy="1.67e-8" iyz="0" izz="1.67e-8" />
	  </inertial>
	</link>


</robot>
